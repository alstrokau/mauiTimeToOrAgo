<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mauiTimeToOrAgo.MainPage">

    <ScrollView>
        <Grid
            RowDefinitions="*, auto"
            Padding="30,0">
            <VerticalStackLayout>
                <Label
                    x:Name="lbOutMain"
                    Text=""
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    x:Name="lbOutSecond"
                    Text=""
                    Style="{StaticResource Headline}"
                    FontSize="52"
                    SemanticProperties.HeadingLevel="Level2" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="1">
                <Label Text="Set target date/time" Margin="5" FontSize="18" />

                <HorizontalStackLayout Margin="5">
                    <DatePicker x:Name="dpTargetDate" DateSelected="dpTargetDate_DateSelected"/>
                    <TimePicker x:Name="tpTargetTime" Format="HH:mm" TimeSelected="tpTargetTime_TimeSelected"/>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
